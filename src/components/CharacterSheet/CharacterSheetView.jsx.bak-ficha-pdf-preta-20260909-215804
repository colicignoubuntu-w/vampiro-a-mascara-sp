        )
        .replace(
          /^-+|-+$/g,
          ''
        )
        .toLowerCase() ||
      'personagem'

    document.title =
      `ficha-${safeName}`

    const restoreTitle = () => {
      document.title =
        previousTitle

      window.removeEventListener(
        'afterprint',
        restoreTitle
      )
    }

    window.addEventListener(
      'afterprint',
      restoreTitle
    )

    window.print()

    window.setTimeout(
      restoreTitle,
      2000
    )
  }

