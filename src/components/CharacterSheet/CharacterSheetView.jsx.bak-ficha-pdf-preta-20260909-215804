            background: #ffffff !important;
            border-color: #000000 !important;
          }

          a {
            text-decoration: none !important;
          }
        }
      `

      document.head.appendChild(
        printStyle
      )
    }

    const previousTitle =
      document.title

    const safeName =
      String(
        identity.name ||
          'personagem'
      )
        .normalize('NFD')
        .replace(
