              font-family: Georgia, serif;
              font-size: 17px;
              border-bottom: 1px solid #000;
            }

            .three-cols {
              display: grid;
              grid-template-columns: repeat(3, 1fr);
              border-bottom: 2px solid #000;
            }

            .col {
              padding: 7px 10px 9px;
              min-height: 105px;
            }

            .col + .col {
              border-left: 1px solid #000;
            }

            .col h3 {
              margin: 0 0 4px;
              font-family: Georgia, serif;
              font-size: 14px;
            }

            .row {
              display: grid;
              grid-template-columns: 1fr auto;
              gap: 10px;
              align-items: center;
              min-height: 20px;
              font-size: 12px;
            }

            .row b,
            .adv-row b,
            .big-dots {
              font-family:
                "DejaVu Sans",
                Arial,
                sans-serif;
