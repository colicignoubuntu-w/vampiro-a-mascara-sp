            <div class="col">
              <h3>${esc(
                String(
                  group.label ||
                  group.title ||
                  ''
                ).toUpperCase()
              )}</h3>

              ${group.items
                .map(item => {
                  const key =
                    item.key ||
                    item.id ||
                    item.value

                  const label =
                    item.label ||
                    item.name ||
                    key

                  return `
                    <div class="row">
                      <span>${esc(label)}</span>
                      <b>${dotLine(
                        getAttributeValue(
                          group.key ||
                            group.id,
                          key
                        ),
                        5
                      )}</b>
                    </div>
                  `
                })
                .join('')}
            </div>
          `
        )
        .join('')

    const abilityHtml =
      abilityColumns
        .map(
          group => `
            <div class="col">
              <h3>${esc(
                String(
                  group.label ||
                  group.title ||
                  ''
                ).toUpperCase()
              )}</h3>

