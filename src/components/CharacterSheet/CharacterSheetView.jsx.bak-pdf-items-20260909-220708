            </div>

            <h2 class="section-title">HABILIDADES</h2>
            <div class="three-cols">
              ${abilityHtml}
            </div>

            <h2 class="section-title">VANTAGENS</h2>
            <div class="advantages">
              <div class="adv-head">
                <span>ANTECEDENTES</span>
