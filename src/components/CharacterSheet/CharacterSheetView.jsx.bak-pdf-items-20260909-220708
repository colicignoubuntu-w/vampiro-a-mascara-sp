              </div>
            </div>

            <div class="observations">
              <h3>OBSERVAÇÕES</h3>
              <div class="obs-line"></div>
              <div class="obs-line"></div>
              <div class="obs-line"></div>
            </div>
          </div>

          <script>
            window.addEventListener(
              'load',
              () => {
                setTimeout(
                  () => window.print(),
                  250
                )
              }
            )
          <\/script>
        </body>
      </html>
    `)

    printWindow.document.close()
  }

  return (
