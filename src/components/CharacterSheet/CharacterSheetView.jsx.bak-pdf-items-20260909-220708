        </button>

        <div>
          <span className="creation-kicker">
            VAMPIRO: SÃO PAULO
          </span>

          <h1>
            Ficha do Personagem
          </h1>
        </div>
      </header>

      <section className="sheet-paper">
        {/* =========================
            IDENTIDADE
        ========================= */}

        <section className="sheet-identity-grid">
          <div>
            <Info
              label="Nome"
              value={
