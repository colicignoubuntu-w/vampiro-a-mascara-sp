.ultimo-gole-screen {
  --ultimo-gole-background: none;
  position: relative;
  min-height: 100%;
  overflow: hidden;
  color: #d9cfcc;
  background: #070606;
}

.ultimo-gole-background {
  position: absolute;
  inset: 0;
  background-image: var(--ultimo-gole-background);
  background-size: cover;
  background-position: center;
  filter: saturate(0.75) brightness(0.52);
  transform: scale(1.02);
}

.ultimo-gole-overlay {
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(5, 4, 4, 0.44),
      rgba(7, 5, 5, 0.77) 58%,
      rgba(5, 4, 4, 0.95)
    ),
    linear-gradient(
      90deg,
      rgba(8, 5, 5, 0.93) 0%,
      rgba(8, 5, 5, 0.5) 52%,
      rgba(8, 5, 5, 0.78) 100%
    );
  pointer-events: none;
}

.ultimo-gole-header,
.ultimo-gole-layout {
  position: relative;
  z-index: 1;
}

.ultimo-gole-header {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 30px;
  padding: 38px 48px 20px;
  border-bottom: 1px solid rgba(255,255,255,0.07);
}

.ultimo-gole-kicker,
.ultimo-gole-section-label,
.ultimo-gole-sidebar span {
  color: #8f6f67;
  font-size: 8px;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.ultimo-gole-header h1 {
  margin: 5px 0 3px;
  color: #efe5df;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: clamp(28px, 3vw, 46px);
  font-weight: 400;
}

.ultimo-gole-header small {
  color: #8f817c;
  font-size: 10px;
}

.ultimo-gole-clock {
  display: grid;
  gap: 3px;
  text-align: right;
}

.ultimo-gole-clock span {
  color: #806f69;
  font-size: 8px;
}

.ultimo-gole-clock strong {
  color: #ccb4aa;
  font-size: 16px;
  font-weight: 400;
}

.ultimo-gole-layout {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 235px;
  gap: 24px;
  padding: 30px 48px 48px;
}

.ultimo-gole-main {
  display: grid;
  align-content: start;
  gap: 22px;
}

.ultimo-gole-description {
  max-width: 900px;
  padding: 22px 24px;
  background: rgba(9, 7, 7, 0.83);
  border-left: 2px solid #74413a;
  backdrop-filter: blur(4px);
}

.ultimo-gole-description > span {
  color: #9c7770;
  font-size: 8px;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.ultimo-gole-description p {
  margin: 11px 0 0;
  max-width: 760px;
  color: #b9adab;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 14px;
  line-height: 1.75;
}

.ultimo-gole-description blockquote {
  margin: 16px 0 0;
  padding: 10px 13px;
  color: #c7a6a2;
  background: rgba(86, 31, 36, 0.15);
  border-left: 2px solid #71313c;
  font-size: 10px;
  line-height: 1.5;
}

.ultimo-gole-navigation,
.ultimo-gole-presence,
.ultimo-gole-encounter {
  display: grid;
  gap: 11px;
  padding: 18px;
  background: rgba(7, 6, 6, 0.84);
  border: 1px solid rgba(255,255,255,0.06);
  backdrop-filter: blur(4px);
}

.ultimo-gole-navigation-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.ultimo-gole-navigation-grid button,
.ultimo-gole-encounter-choices button,
.ultimo-gole-secondary {
  min-height: 68px;
  padding: 12px 14px;
  display: grid;
  align-content: center;
  gap: 5px;
  color: #c9bcba;
  background: rgba(24, 18, 18, 0.9);
  border: 1px solid #382a28;
  cursor: pointer;
  text-align: left;
}

.ultimo-gole-navigation-grid button:hover,
.ultimo-gole-encounter-choices button:hover,
.ultimo-gole-secondary:hover {
  color: #f0dfdc;
  background: rgba(62, 29, 27, 0.86);
  border-color: #70453d;
}

.ultimo-gole-navigation-grid button strong {
  font-size: 11px;
  font-weight: 500;
}

.ultimo-gole-navigation-grid button span {
  color: #786b67;
  font-size: 8px;
}

.ultimo-gole-navigation-grid button.locked {
  opacity: 0.45;
}

.ultimo-gole-person {
  display: grid;
  grid-template-columns: 54px minmax(0, 1fr) auto;
  gap: 12px;
  align-items: center;
  padding: 11px;
  background: rgba(35, 20, 20, 0.75);
  border: 1px solid #452a29;
}

.ultimo-gole-person-avatar {
  width: 54px;
  height: 54px;
  overflow: hidden;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #1b1515;
}

.ultimo-gole-person-avatar img,
.ultimo-gole-encounter-speaker img {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.ultimo-gole-person > div:nth-child(2) {
  display: grid;
  gap: 3px;
}

.ultimo-gole-person strong {
  color: #e2d5d1;
  font-size: 11px;
}

.ultimo-gole-person span {
  color: #8a7d79;
  font-size: 9px;
}

.ultimo-gole-person button {
  min-height: 34px;
  padding: 7px 10px;
  color: #d6b4ad;
  background: #241717;
  border: 1px solid #5f3934;
  cursor: pointer;
}

.ultimo-gole-encounter-speaker {
  display: grid;
  grid-template-columns: 74px 1fr;
  gap: 14px;
}

.ultimo-gole-encounter-speaker img {
  width: 74px;
  height: 74px;
  border-radius: 50%;
}

.ultimo-gole-encounter-speaker > div {
  display: grid;
  align-content: center;
  gap: 7px;
}

.ultimo-gole-encounter-speaker span {
  color: #a76f69;
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
}

.ultimo-gole-encounter-speaker p {
  margin: 0;
  color: #d6c9c5;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 14px;
  line-height: 1.6;
}

.ultimo-gole-encounter-choices {
  display: grid;
  gap: 7px;
}

.ultimo-gole-encounter-choices button,
.ultimo-gole-secondary {
  min-height: 46px;
}

.ultimo-gole-sidebar {
  display: grid;
  align-content: start;
  gap: 9px;
}

.ultimo-gole-sidebar section {
  display: grid;
  gap: 5px;
  padding: 13px;
  background: rgba(8, 7, 7, 0.82);
  border: 1px solid rgba(255,255,255,0.06);
}

.ultimo-gole-sidebar strong {
  color: #c8bcb8;
  font-size: 11px;
  font-weight: 500;
}

.ultimo-gole-sidebar small {
  color: #786e6b;
  font-size: 8px;
}

.ultimo-gole-leave,
.ultimo-gole-map {
  min-height: 42px;
  padding: 9px;
  color: #a79690;
  background: rgba(15, 11, 11, 0.9);
  border: 1px solid #392b28;
  cursor: pointer;
}

.ultimo-gole-leave:hover,
.ultimo-gole-map:hover {
  color: #e0ceca;
  border-color: #67463f;
}

@media (max-width: 850px) {
  .ultimo-gole-header {
    padding: 25px 20px 16px;
  }

  .ultimo-gole-layout {
    grid-template-columns: 1fr;
    padding: 20px;
  }

  .ultimo-gole-navigation-grid {
    grid-template-columns: 1fr;
  }

  .ultimo-gole-sidebar {
    grid-template-columns: repeat(2, 1fr);
  }
}


/* ==========================================
   DIÁLOGO NO PADRÃO DAS CENAS DO JOGO
========================================== */

.ultimo-gole-dialogue-scene {
  position: relative;
  min-height: 470px;
  display: flex;
  align-items: flex-end;
  overflow: hidden;
  padding: 0;
  background: transparent;
  border: 0;
}

.ultimo-gole-scene-character {
  position: absolute;
  right: 0;
  bottom: 0;
  z-index: 1;

  width: min(42vw, 520px);
  height: min(68vh, 690px);

  object-fit: contain;
  object-position: center bottom;

  filter:
    drop-shadow(0 16px 28px rgba(0, 0, 0, 0.72))
    saturate(0.92);

  pointer-events: none;
  user-select: none;
}

.ultimo-gole-dialogue-content {
  position: relative;
  z-index: 2;

  width: min(72%, 860px);
  display: grid;
  gap: 14px;

  padding: 0 0 18px;
}

.ultimo-gole-dialogue-box {
  padding: 22px 26px;
  background:
    linear-gradient(
      90deg,
      rgba(24, 10, 12, 0.96),
      rgba(24, 10, 12, 0.88) 76%,
      rgba(24, 10, 12, 0.62)
    );

  border-left: 2px solid #8b3645;
  border-top: 1px solid rgba(139, 54, 69, 0.18);
  border-bottom: 1px solid rgba(139, 54, 69, 0.18);

  box-shadow:
    0 20px 48px rgba(0, 0, 0, 0.28);
}

.ultimo-gole-dialogue-speaker {
  display: block;
  margin-bottom: 10px;

  color: #b34f61;
  font-size: 9px;
  font-weight: 600;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.ultimo-gole-dialogue-box p {
  margin: 0;

  color: #dfd3cf;
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 15px;
  font-style: italic;
  line-height: 1.72;
}

.ultimo-gole-encounter-choices {
  width: 100%;
  display: grid;
  gap: 8px;
}

.ultimo-gole-encounter-choices button,
.ultimo-gole-secondary {
  position: relative;
  z-index: 3;

  min-height: 50px;
  padding: 12px 16px;

  color: #cdbfba;
  background: rgba(20, 14, 14, 0.94);

  border: 1px solid #3d2b2b;
  border-left: 1px solid #5a3035;

  cursor: pointer;
  text-align: left;

  font-size: 10px;
  line-height: 1.4;
}

.ultimo-gole-encounter-choices button:hover,
.ultimo-gole-secondary:hover {
  color: #f0dddd;
  background: rgba(54, 25, 28, 0.96);
  border-color: #75404a;
}

@media (max-width: 900px) {
  .ultimo-gole-dialogue-scene {
    min-height: 520px;
  }

  .ultimo-gole-scene-character {
    right: -50px;
    width: min(56vw, 430px);
    height: 58vh;
    opacity: 0.72;
  }

  .ultimo-gole-dialogue-content {
    width: 92%;
  }
}

@media (max-width: 620px) {
  .ultimo-gole-dialogue-scene {
    min-height: 560px;
  }

  .ultimo-gole-scene-character {
    right: -95px;
    width: 78vw;
    height: 52vh;
    opacity: 0.55;
  }

  .ultimo-gole-dialogue-content {
    width: 100%;
  }

  .ultimo-gole-dialogue-box {
    padding: 18px;
  }
}
