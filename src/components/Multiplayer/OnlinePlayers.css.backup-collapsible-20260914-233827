.online-players {
  position: fixed;

  top: 50%;
  right: clamp(35px, 6vw, 110px);

  width: 250px;

  transform: translateY(-50%);

  padding: 22px;

  box-sizing: border-box;

  border:
    1px solid
    rgba(120, 31, 39, 0.35);

  background:
    linear-gradient(
      145deg,
      rgba(7, 7, 7, 0.76),
      rgba(17, 7, 9, 0.64)
    );

  backdrop-filter: blur(8px);

  box-shadow:
    0 20px 60px
    rgba(0, 0, 0, 0.38);

  color: #d7ceca;

  z-index: 10;
}

.online-players-header {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding-bottom: 14px;

  border-bottom:
    1px solid
    rgba(255, 255, 255, 0.08);
}

.online-players-header > div {
  display: flex;
  align-items: center;
  gap: 8px;
}

.online-status-dot {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #665d5d;
}

.online-status-dot.online {
  background: #8fa779;

  box-shadow:
    0 0 8px
    rgba(143, 167, 121, 0.5);
}

.online-status-label {
  color: #807776;

  font-family:
    Arial,
    sans-serif;

  font-size: 0.59rem;
  font-weight: 700;

  letter-spacing: 0.22em;
}

.online-players-header strong {
  color: #a62b36;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 1rem;
  font-weight: 400;
}

.online-players-title {
  margin-top: 17px;
  margin-bottom: 16px;

  color: #8c8380;

  font-family:
    Arial,
    sans-serif;

  font-size: 0.56rem;
  font-weight: 700;

  letter-spacing: 0.2em;
}

.online-players-list {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.online-player {
  display: flex;
  align-items: center;
  gap: 11px;

  min-height: 44px;

  padding: 7px 4px;

  box-sizing: border-box;
}

.online-player-dot {
  flex: 0 0 auto;

  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #768a68;
}

.online-player > div {
  display: flex;
  flex-direction: column;
  gap: 4px;

  min-width: 0;
}

.online-player strong {
  overflow: hidden;

  color: #cfc6c2;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.78rem;
  font-weight: 400;

  text-overflow: ellipsis;
  white-space: nowrap;
}

.online-player strong small {
  margin-left: 7px;

  color: #8c2932;

  font-family:
    Arial,
    sans-serif;

  font-size: 0.46rem;

  letter-spacing: 0.12em;
}

.online-player > div > span {
  color: #625b59;

  font-family:
    Arial,
    sans-serif;

  font-size: 0.54rem;

  letter-spacing: 0.07em;
}

.online-empty {
  margin: 4px 0;

  color: #625b59;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.72rem;
}

.online-set-name {
  width: 100%;

  margin-bottom: 13px;
  padding: 10px;

  border:
    1px solid
    rgba(137, 33, 42, 0.55);

  color: #b6a9a6;
  background: transparent;

  font-size: 0.55rem;

  letter-spacing: 0.15em;

  cursor: pointer;
}

.online-name-form {
  display: flex;
  gap: 6px;

  margin-bottom: 14px;
}

.online-name-form input {
  min-width: 0;
  flex: 1;

  padding: 8px;

  border:
    1px solid
    rgba(255, 255, 255, 0.13);

  outline: none;

  color: #d5cdca;
  background: #090909;
}

.online-name-form input:focus {
  border-color: #76232b;
}

.online-name-form button {
  border:
    1px solid
    #76232b;

  color: #c7bcba;
  background: #351015;

  font-size: 0.5rem;

  cursor: pointer;
}

.online-error {
  color: #b96d72;

  font-size: 0.68rem;
}

@media (max-width: 900px) {
  .online-players {
    position: relative;

    top: auto;
    right: auto;

    width: 100%;

    margin-top: 25px;

    transform: none;
  }
}