.auth-screen {
  position: fixed;
  inset: 0;
  z-index: 9999;

  min-height: 100vh;
  overflow: auto;

  color: #ddd5d1;
  background: #020202;
}

.auth-background {
  position: absolute;
  inset: 0;

  background-image:
    url('/images/ui/vampiro-sao-paulo-login-bg.png');

  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;

  transform: scale(1.01);
}

.auth-vignette {
  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.97) 0%,
      rgba(0, 0, 0, 0.92) 18%,
      rgba(0, 0, 0, 0.72) 36%,
      rgba(0, 0, 0, 0.24) 58%,
      rgba(0, 0, 0, 0.08) 76%,
      rgba(0, 0, 0, 0.3) 100%
    ),
    linear-gradient(
      180deg,
      rgba(0, 0, 0, 0.3),
      transparent 35%,
      rgba(0, 0, 0, 0.42)
    );
}

.auth-content {
  position: relative;
  z-index: 2;

  display: flex;
  flex-direction: column;

  width: min(520px, calc(100vw - 80px));
  min-height: 100vh;

  box-sizing: border-box;

  margin-left: clamp(
    70px,
    10vw,
    190px
  );

  padding:
    clamp(65px, 8vh, 120px)
    0
    42px;
}

.auth-brand {
  margin-bottom: 38px;
}

.auth-brand-kicker {
  display: block;

  margin-bottom: 5px;

  color: #a72b37;

  font-family:
    Arial,
    sans-serif;

  font-size: 0.72rem;
  font-weight: 700;

  letter-spacing: 0.48em;
}

.auth-brand h1 {
  display: flex;
  flex-direction: column;

  margin: 0;

  color: #e9e1dc;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: clamp(
    4.2rem,
    6.5vw,
    7.4rem
  );

  font-weight: 400;

  line-height: 0.83;

  letter-spacing: 0.035em;

  text-shadow:
    0 2px 16px
    rgba(0, 0, 0, 0.9);
}

.auth-brand h1 span {
  display: block;
}

.auth-brand p {
  margin:
    27px
    0
    0;

  color: #837b79;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.92rem;

  line-height: 1.7;
}

.auth-panel {
  width: 100%;

  box-sizing: border-box;

  padding:
    0
    25px
    26px;

  border:
    1px
    solid
    rgba(108, 28, 35, 0.55);

  background:
    linear-gradient(
      145deg,
      rgba(10, 8, 8, 0.91),
      rgba(5, 5, 5, 0.78)
    );

  backdrop-filter:
    blur(5px);

  box-shadow:
    0 22px 70px
    rgba(0, 0, 0, 0.55);
}

.auth-tabs {
  display: grid;
  grid-template-columns:
    1fr
    1fr;

  margin-bottom: 27px;

  border-bottom:
    1px
    solid
    rgba(117, 101, 101, 0.25);
}

.auth-tab {
  position: relative;

  padding:
    19px
    8px
    16px;

  border: 0;

  color: #6e6666;
  background: transparent;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.78rem;

  letter-spacing: 0.17em;

  cursor: pointer;
}

.auth-tab::after {
  content: '';

  position: absolute;

  left: 0;
  right: 0;
  bottom: -1px;

  height: 2px;

  background: transparent;
}

.auth-tab.active {
  color: #e0d8d4;
}

.auth-tab.active::after {
  background: #a5202d;
}

.auth-field {
  display: block;

  margin-bottom: 19px;
}

.auth-field > span {
  display: block;

  margin-bottom: 8px;

  color: #a39a96;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.68rem;

  letter-spacing: 0.17em;
}

.auth-field input {
  display: block;

  width: 100%;
  height: 48px;

  box-sizing: border-box;

  padding:
    0
    15px;

  border:
    1px
    solid
    rgba(120, 108, 108, 0.38);

  border-radius: 0;
  outline: none;

  color: #ded7d3;

  background:
    rgba(14, 14, 14, 0.83);

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.92rem;

  transition:
    border-color
    150ms ease,
    background
    150ms ease;
}

.auth-field input::placeholder {
  color: #565050;
}

.auth-field input:focus {
  border-color:
    rgba(
      155,
      35,
      45,
      0.85
    );

  background:
    rgba(18, 15, 15, 0.94);
}

.auth-forgot {
  margin:
    -6px
    0
    22px;

  padding: 0;

  border: 0;

  color: #a32834;
  background: transparent;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.75rem;

  cursor: pointer;
}

.auth-forgot:hover {
  color: #ce3c49;
}

.auth-submit {
  width: 100%;
  height: 50px;

  border:
    1px
    solid
    #9c2531;

  color: #eee5e1;

  background:
    linear-gradient(
      90deg,
      rgba(
        87,
        18,
        27,
        0.92
      ),
      rgba(
        63,
        12,
        18,
        0.92
      )
    );

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.75rem;

  letter-spacing: 0.22em;

  cursor: pointer;

  transition:
    background
    150ms ease,
    border-color
    150ms ease;
}

.auth-submit:hover:not(:disabled) {
  border-color: #c13643;

  background:
    linear-gradient(
      90deg,
      #711923,
      #501017
    );
}

.auth-submit:disabled {
  cursor: wait;
  opacity: 0.55;
}

.auth-feedback {
  box-sizing: border-box;

  margin-bottom: 18px;
  padding: 11px 13px;

  border:
    1px
    solid;

  font-size: 0.76rem;

  line-height: 1.45;
}

.auth-feedback.error {
  border-color:
    rgba(
      150,
      40,
      49,
      0.55
    );

  color: #d19a9e;

  background:
    rgba(
      87,
      14,
      20,
      0.18
    );
}

.auth-feedback.success {
  border-color:
    rgba(
      94,
      118,
      88,
      0.5
    );

  color: #b4c1ad;

  background:
    rgba(
      45,
      65,
      41,
      0.16
    );
}

.auth-footer {
  display: flex;
  align-items: center;
  gap: 18px;

  margin-top: auto;
  padding-top: 34px;

  color: #555050;

  font-family:
    Arial,
    sans-serif;

  font-size: 0.55rem;

  letter-spacing: 0.19em;
}

.auth-footer i {
  width: 1px;
  height: 11px;

  background: #7c2028;
}

.auth-city-caption {
  position: absolute;
  z-index: 2;

  right: clamp(
    55px,
    8vw,
    150px
  );

  bottom: clamp(
    60px,
    9vh,
    120px
  );

  display: flex;
  flex-direction: column;

  color:
    rgba(
      219,
      205,
      197,
      0.7
    );

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  text-align: right;

  text-shadow:
    0 3px 15px
    #000;
}

.auth-city-caption span {
  font-size: 0.65rem;

  letter-spacing: 0.32em;
}

.auth-city-caption strong {
  margin-top: 5px;

  color:
    rgba(
      169,
      39,
      50,
      0.8
    );

  font-size: 0.75rem;
  font-weight: 400;

  letter-spacing: 0.19em;
}

@media (
  max-width: 900px
) {
  .auth-vignette {
    background:
      linear-gradient(
        90deg,
        rgba(
          0,
          0,
          0,
          0.94
        ),
        rgba(
          0,
          0,
          0,
          0.72
        )
      );
  }

  .auth-content {
    margin:
      0
      auto;

    width:
      min(
        520px,
        calc(
          100vw - 40px
        )
      );
  }

  .auth-city-caption {
    display: none;
  }
}

@media (
  max-width: 520px
) {
  .auth-content {
    width:
      calc(
        100vw - 28px
      );

    padding-top: 45px;
  }

  .auth-brand h1 {
    font-size: 4rem;
  }

  .auth-panel {
    padding:
      0
      17px
      20px;
  }

  .auth-brand p {
    font-size: 0.82rem;
  }
}

/* ========================================
   MODO DESCONHECIDO / VISITANTE
   ======================================== */

.auth-guest {
  margin-top: 22px;
}

.auth-guest-divider {
  display: grid;
  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;
  gap: 12px;

  margin:
    2px
    0
    18px;
}

.auth-guest-divider > span {
  height: 1px;

  background:
    rgba(
      117,
      101,
      101,
      0.25
    );
}

.auth-guest-divider small {
  color: #61595a;

  font-family:
    Arial,
    sans-serif;

  font-size: 0.52rem;

  letter-spacing: 0.2em;
}

.auth-guest-button {
  width: 100%;
  min-height: 57px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 4px;

  padding:
    10px
    14px;

  border:
    1px solid
    rgba(
      126,
      109,
      109,
      0.42
    );

  color: #c9c0bc;

  background:
    rgba(
      11,
      10,
      10,
      0.72
    );

  cursor: pointer;

  transition:
    border-color
      150ms ease,
    background
      150ms ease,
    color
      150ms ease;
}

.auth-guest-button strong {
  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.68rem;
  font-weight: 400;

  letter-spacing: 0.16em;
}

.auth-guest-button span {
  color: #71696a;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.68rem;

  letter-spacing: 0.02em;
}

.auth-guest-button:hover:not(:disabled) {
  color: #e0d8d4;

  border-color:
    rgba(
      151,
      49,
      59,
      0.75
    );

  background:
    rgba(
      41,
      14,
      18,
      0.55
    );
}

.auth-guest-button:hover:not(:disabled)
.auth-guest-button span {
  color: #8f8384;
}

.auth-guest-button:disabled {
  opacity: 0.5;
  cursor: wait;
}

.auth-guest-note {
  max-width: 390px;

  margin:
    11px
    auto
    0;

  color: #5e5758;

  font-family:
    Georgia,
    'Times New Roman',
    serif;

  font-size: 0.65rem;

  line-height: 1.55;

  text-align: center;
}

