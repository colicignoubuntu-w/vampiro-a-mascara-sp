.livia-computer {
  position: relative;
  z-index: 2;
  width: min(1180px, calc(100vw - 36px));
  margin: 0 auto;
  padding: 28px 0 110px;
  color: #d9e2dc;
}

.livia-monitor {
  position: relative;
  padding: 22px 22px 0;
  border: 1px solid #4c4a43;
  border-radius: 18px 18px 10px 10px;
  background:
    linear-gradient(145deg, #373630 0%, #171714 46%, #2b2924 100%);
  box-shadow:
    0 34px 90px #000c,
    inset 0 1px 0 #77746b55,
    inset 0 -2px 0 #000;
}

.livia-screen {
  position: relative;
  min-height: 650px;
  overflow: hidden;
  border: 2px solid #080908;
  border-radius: 8px;
  background: #08100f;
  box-shadow:
    inset 0 0 55px #000,
    0 0 0 1px #67645b44;
}

.livia-screen::after {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 20;
  pointer-events: none;
  opacity: .17;
  background: repeating-linear-gradient(
    to bottom,
    transparent 0,
    transparent 2px,
    #000 3px,
    #000 4px
  );
  mix-blend-mode: multiply;
}

.livia-wallpaper {
  position: absolute;
  inset: 0;
  overflow: hidden;
  background:
    radial-gradient(circle at 68% 34%, #24443b 0, #102822 20%, transparent 42%),
    linear-gradient(145deg, #071411, #0d2620 55%, #07100f);
}

.livia-wallpaper-glow {
  position: absolute;
  width: 520px;
  height: 520px;
  right: 7%;
  top: 5%;
  border: 1px solid #6e978055;
  border-radius: 50%;
  box-shadow:
    0 0 90px #4f8d7040,
    inset 0 0 80px #1d463733;
}

.livia-wallpaper-mark {
  position: absolute;
  right: 15%;
  top: 13%;
  color: #aec4b018;
  font: 400 310px/1 Georgia, serif;
  text-shadow: 0 0 45px #b7d8c51c;
  transform: rotate(-7deg);
  user-select: none;
}

.livia-desktop {
  position: relative;
  min-height: 650px;
  padding: 20px 20px 54px;
}

.livia-desktop-icons {
  position: relative;
  z-index: 2;
  display: grid;
  grid-template-columns: repeat(2, 105px);
  align-content: start;
  gap: 20px 14px;
  width: max-content;
}

.livia-desktop-icon {
  position: relative;
  display: flex;
  min-height: 92px;
  flex-direction: column;
  align-items: center;
  justify-content: flex-start;
  gap: 6px;
  padding: 6px;
  border: 1px solid transparent;
  border-radius: 3px;
  color: #f1f4ed;
  background: transparent;
  font: inherit;
  cursor: pointer;
  text-align: center;
  text-shadow: 1px 2px 2px #000;
}

.livia-desktop-icon:hover:not(:disabled),
.livia-desktop-icon:focus-visible {
  border-color: #b6d3c25c;
  background: #c7e0d218;
  outline: none;
}

.livia-desktop-icon:disabled {
  opacity: .45;
  cursor: not-allowed;
}

.livia-desktop-icon-art {
  display: grid;
  width: 48px;
  height: 48px;
  place-items: center;
  font-size: 37px;
  filter: drop-shadow(2px 3px 2px #0009);
}

.livia-desktop-icon-label {
  max-width: 100px;
  font-size: 11px;
  line-height: 1.25;
}

.livia-desktop-icon-badge {
  position: absolute;
  top: 2px;
  right: 15px;
  display: grid;
  min-width: 19px;
  height: 19px;
  place-items: center;
  border: 1px solid #d3c6a2;
  border-radius: 50%;
  color: #1b1711;
  background: #e2c882;
  font-size: 10px;
  font-weight: 800;
  text-shadow: none;
}

.livia-window {
  position: absolute;
  z-index: 10;
  top: 48px;
  left: 180px;
  right: 54px;
  min-height: 455px;
  overflow: hidden;
  border: 1px solid #9aa79f;
  border-radius: 4px;
  background: #d7ddd8;
  box-shadow: 18px 24px 60px #000b;
  color: #1c2420;
}

.livia-window-titlebar {
  display: flex;
  height: 35px;
  align-items: center;
  justify-content: space-between;
  padding-left: 10px;
  color: #eaf2ec;
  background: linear-gradient(#33483f, #1c2f28);
  border-bottom: 1px solid #0c1713;
}

.livia-window-title {
  display: flex;
  align-items: center;
  gap: 8px;
  overflow: hidden;
  font-size: 12px;
  font-weight: 700;
  white-space: nowrap;
}

.livia-window-close {
  align-self: stretch;
  width: 44px;
  border: 0;
  border-left: 1px solid #617068;
  color: #f5f5f1;
  background: #5c312f;
  font-size: 23px;
  cursor: pointer;
}

.livia-window-close:hover {
  background: #8a3934;
}

.livia-window-toolbar {
  display: flex;
  min-height: 36px;
  align-items: center;
  gap: 12px;
  padding: 5px 8px;
  border-bottom: 1px solid #aab0ab;
  background: #c8cfca;
  font-size: 10px;
}

.livia-window-toolbar button {
  border: 1px solid #939d96;
  border-radius: 2px;
  padding: 5px 9px;
  color: #25322c;
  background: #e4e8e4;
  font: inherit;
  cursor: pointer;
}

.livia-window-toolbar span {
  flex: 1;
  overflow: hidden;
  padding: 5px 8px;
  border: 1px solid #a4aaa5;
  background: #f0f3f0;
  color: #657069;
  white-space: nowrap;
}

.livia-window-content {
  min-height: 384px;
  max-height: 510px;
  overflow: auto;
  background: #eef1ee;
}

.livia-folder-view {
  padding: 10px;
}

.livia-folder-heading {
  display: grid;
  grid-template-columns: 1fr 150px;
  padding: 7px 10px 7px 52px;
  border-bottom: 1px solid #b6bcb7;
  color: #657069;
  font-size: 10px;
  text-transform: uppercase;
  letter-spacing: .05em;
}

.livia-file-row {
  display: grid;
  width: 100%;
  grid-template-columns: 38px minmax(0, 1fr) 150px;
  align-items: center;
  gap: 8px;
  padding: 10px;
  border: 0;
  border-bottom: 1px solid #d3d8d4;
  color: #1c2520;
  background: transparent;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.livia-file-row:hover:not(:disabled) {
  background: #cddbd2;
}

.livia-file-row:disabled {
  opacity: .55;
  cursor: not-allowed;
}

.livia-file-row-icon {
  font-size: 25px;
}

.livia-file-row-copy {
  display: flex;
  flex-direction: column;
  gap: 4px;
}

.livia-file-row-copy strong {
  color: #18241e;
  font: 600 13px/1.3 Arial, sans-serif;
}

.livia-file-row-copy small {
  color: #647069;
  font-size: 10px;
  line-height: 1.4;
}

.livia-file-row .is-read,
.livia-file-row .is-unread {
  display: flex;
  flex-direction: column;
  gap: 3px;
  font-size: 10px;
}

.livia-file-row .is-read {
  color: #3d6a50;
}

.livia-file-row .is-unread {
  color: #8a5a27;
  font-weight: 700;
}

.livia-file-row .is-read small,
.livia-file-row .is-unread small {
  color: #77817b;
  font-size: 9px;
  font-weight: 400;
}

.livia-computer-investigation {
  padding: 32px;
}

.livia-computer-kicker {
  color: #7b3f43;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: .13em;
}

.livia-computer-investigation h2,
.livia-empty-folder h2 {
  margin: 8px 0 12px;
  color: #1b2721;
  font: 400 27px/1.2 Georgia, serif;
}

.livia-computer-investigation p,
.livia-empty-folder p {
  max-width: 720px;
  color: #4d5a53;
  font-size: 12px;
  line-height: 1.7;
}

.livia-computer-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 22px;
}

.livia-computer-actions button {
  border: 1px solid #8f9992;
  border-radius: 3px;
  padding: 9px 12px;
  color: #253129;
  background: #dde2de;
  font: inherit;
  font-size: 11px;
  cursor: pointer;
}

.livia-computer-actions .is-primary {
  border-color: #4d6b5a;
  color: #f3f6f3;
  background: #385647;
}

.livia-computer-actions button:disabled {
  opacity: .5;
  cursor: not-allowed;
}

.livia-computer-next {
  margin-top: 18px;
  padding: 10px 12px;
  border-left: 3px solid #6b7e72;
  background: #dce3de;
}

.livia-notepad {
  min-height: 384px;
  background: #f4f2e9;
}

.livia-notepad-menu {
  padding: 6px 10px;
  border-bottom: 1px solid #c7c4b9;
  color: #474c48;
  background: #deddd6;
  font-size: 10px;
}

.livia-notepad-paper {
  padding: 22px 26px 34px;
  color: #252925;
  font: 12px/1.65 "Courier New", monospace;
}

.livia-notepad-paper p {
  margin: 0 0 15px;
  white-space: pre-line;
}

.livia-empty-folder {
  display: grid;
  min-height: 360px;
  place-items: center;
  align-content: center;
  text-align: center;
}

.livia-empty-folder > span {
  font-size: 55px;
  opacity: .7;
}

.livia-taskbar {
  position: absolute;
  z-index: 15;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  height: 39px;
  align-items: stretch;
  border-top: 1px solid #5c6b63;
  background: linear-gradient(#273b32, #17271f);
  box-shadow: 0 -1px 8px #0006;
}

.livia-start {
  display: flex;
  align-items: center;
  gap: 6px;
  min-width: 88px;
  border: 0;
  border-right: 1px solid #5a6c62;
  padding: 0 12px;
  color: #e6eee9;
  background: #304d3e;
  font: 700 11px Arial, sans-serif;
  cursor: pointer;
}

.livia-start:hover {
  background: #416351;
}

.livia-taskbar-current {
  display: flex;
  flex: 1;
  align-items: center;
  padding: 4px 7px;
}

.livia-taskbar-current button {
  max-width: 260px;
  height: 29px;
  overflow: hidden;
  border: 1px solid #56665d;
  padding: 0 10px;
  color: #d9e2dc;
  background: #1c3027;
  font: 10px Arial, sans-serif;
  text-overflow: ellipsis;
  white-space: nowrap;
  cursor: pointer;
}

.livia-tray {
  display: flex;
  min-width: 132px;
  align-items: center;
  justify-content: flex-end;
  gap: 9px;
  padding: 0 10px;
  border-left: 1px solid #56665d;
  color: #cfdad3;
  background: #1b3026;
  font: 10px Arial, sans-serif;
}

.livia-monitor-bottom {
  display: flex;
  height: 44px;
  align-items: center;
  padding: 0 18px;
  color: #77766f;
  font: 700 9px Arial, sans-serif;
  letter-spacing: .14em;
}

.livia-monitor-brand {
  margin-right: auto;
}

.livia-monitor-led {
  width: 5px;
  height: 5px;
  margin-right: 10px;
  border-radius: 50%;
  background: #70b178;
  box-shadow: 0 0 7px #70b178;
}

.livia-monitor-day {
  color: #5d5c56;
}

.livia-computer-controls {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 14px 10px 0;
  color: #8d8c85;
  font-size: 10px;
}

.livia-computer-controls button {
  border: 1px solid #514a4a;
  border-radius: 4px;
  padding: 9px 12px;
  color: #d5c9cc;
  background: #1a1517;
  font: inherit;
  cursor: pointer;
}

.livia-computer-controls button:hover:not(:disabled) {
  border-color: #80656c;
  background: #2a1c21;
}

.livia-computer-controls button:disabled {
  opacity: .45;
  cursor: not-allowed;
}

@media (max-width: 760px) {
  .livia-computer {
    width: calc(100vw - 16px);
    padding-top: 12px;
  }

  .livia-monitor {
    padding: 10px 10px 0;
    border-radius: 10px;
  }

  .livia-screen,
  .livia-desktop {
    min-height: 620px;
  }

  .livia-desktop {
    padding: 14px 10px 50px;
  }

  .livia-desktop-icons {
    grid-template-columns: repeat(2, 92px);
    gap: 12px 6px;
  }

  .livia-window {
    top: 115px;
    right: 8px;
    left: 8px;
    min-height: 430px;
  }

  .livia-window-content {
    max-height: 460px;
  }

  .livia-folder-heading {
    display: none;
  }

  .livia-file-row {
    grid-template-columns: 34px minmax(0, 1fr);
  }

  .livia-file-row .is-read,
  .livia-file-row .is-unread {
    grid-column: 2;
  }

  .livia-computer-investigation {
    padding: 20px;
  }

  .livia-tray span {
    display: none;
  }

  .livia-tray {
    min-width: 62px;
  }

  .livia-computer-controls {
    align-items: stretch;
    flex-direction: column;
  }
}
